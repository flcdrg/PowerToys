<UserControl
    x:Class="Microsoft.PowerToys.Settings.UI.Controls.DisplayArrangementPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinHeight="180"
    mc:Ignorable="d">
    <Grid>
        <!--
            The panel renders entirely in code-behind using a Canvas, because display
            positions and edge-drop-zones depend on runtime pixel maths that are much
            cleaner in C# than in XAML bindings.
        -->
        <Canvas
            x:Name="LayoutCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AllowDrop="True"
            Background="Transparent"
            DragOver="Canvas_DragOver"
            Drop="Canvas_Drop"
            SizeChanged="LayoutCanvas_SizeChanged" />
        <TextBlock
            x:Name="NoDisplaysText"
            x:Uid="MWB_DisplayArrangement_NoDisplaysText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
